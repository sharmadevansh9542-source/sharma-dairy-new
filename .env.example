DATABASE_URL="postgresql://postgres:change-me@localhost:5433/sharma_dairy?schema=public"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

DAIRY_NAME="Sharma Dairy"
DAIRY_TIMEZONE="Asia/Kolkata"
CURRENCY="INR"

# Initial Tenant Dairy Admin Bootstrap
BOOTSTRAP_ADMIN_NAME="Dairy Administrator"
BOOTSTRAP_ADMIN_EMAIL="admin@example.com"
BOOTSTRAP_ADMIN_PASSWORD="replace-with-a-strong-password-14chars"

# Platform Owner Super Admin One-Time Bootstrap (Never expose publicly)
SUPER_ADMIN_NAME="Platform Super Admin"
SUPER_ADMIN_EMAIL="superadmin@example.com"
SUPER_ADMIN_PASSWORD="replace-with-a-super-admin-password-14chars"

# Email Delivery (Resend)
RESEND_API_KEY="re_replace-with-your-api-key"
EMAIL_FROM="Sharma Dairy <no-reply@example.com>"

# Optional: WhatsApp Business Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
