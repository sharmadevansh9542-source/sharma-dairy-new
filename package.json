    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.14",
        "prisma": "^6.19.0",
        "tailwindcss": "^4.1.14",
        "typescript": "^5.9.3",
        "@types/node": "^22.18.10",
        "@types/react": "^19.1.16",
